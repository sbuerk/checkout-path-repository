{
    "name": "sbuerk/checkout-path-repository",
    "description": "Composer plugin that registers local git checkouts listed in a manifest as path repositories, pins their versions and adds them as root requirements - optional checkouts that are missing are skipped.",
    "license": "GPL-2.0-or-later",
    "type": "composer-plugin",
    "keywords": [
        "composer",
        "composer-plugin",
        "path",
        "repository",
        "checkout",
        "monorepo",
        "development",
        "typo3"
    ],
    "authors": [
        {
            "name": "Stefan Bürk",
            "email": "stefan@buerk.tech",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.1",
        "composer-plugin-api": "^2.3"
    },
    "require-dev": {
        "composer/composer": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "SBUERK\\CheckoutPathRepository\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SBUERK\\CheckoutPathRepository\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "SBUERK\\CheckoutPathRepository\\Plugin",
        "plugin-optional": false
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "sbuerk/checkout-path-repository": true
        }
    },
    "scripts": {
        "ci:php:cs": "php-cs-fixer fix --dry-run --diff --using-cache=no",
        "ci:php:stan": "phpstan analyse --no-progress",
        "ci:tests:unit": "phpunit --configuration phpunit.xml.dist --testsuite unit",
        "ci:tests:integration": "phpunit --configuration phpunit.xml.dist --testsuite integration",
        "ci:tests": [
            "@ci:tests:unit",
            "@ci:tests:integration"
        ],
        "ci": [
            "@ci:php:cs",
            "@ci:php:stan",
            "@ci:tests"
        ],
        "fix:cs": "php-cs-fixer fix --using-cache=no"
    }
}
